{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill",
            "type": "shell",
            "command": "pgrep -f AeroSpaceBar && pkill -f AeroSpaceBar || true",
            "group": "build",
            "detail": "Kill any running AeroSpaceBar instances",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "build",
            "type": "sweetpad",
            "action": "build",
            "problemMatcher": [
                "$sweetpad-watch",
                "$sweetpad-xcodebuild-default",
                "$sweetpad-xcbeautify-errors",
                "$sweetpad-xcbeautify-warnings"
            ],
            "detail": "Build the app using sweetpad",
            "isBackground": false
        },
        {
            "label": "run (without build)",
            "type": "shell",
            "command": "${HOME}/Library/Developer/Xcode/DerivedData/AeroSpaceBar-fifbaernwsaqwhfwajnuubouitxw/Build/Products/Debug/AeroSpaceBar.app/Contents/MacOS/AeroSpaceBar",
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Run the built app",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "run",
            "detail": "Build the app then run it",
            "dependsOn": [
                "kill",
                "build",
                "run (without build)"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
