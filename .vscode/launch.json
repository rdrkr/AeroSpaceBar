    "version": "0.2.0",
    "configurations": [
        {
            "type": "sweetpad-lldb",
            "request": "attach",
            "name": "SweetPad: Build and Run (Wait for debugger)",
            "preLaunchTask": "sweetpad: debugging-launch"
        },
        {
            "type": "lldb",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:AeroSpaceBar}",
            "name": "Debug AeroSpaceBar",
            "program": "${workspaceFolder:AeroSpaceBar}/.build/debug/AeroSpaceBar",
            "preLaunchTask": "swift: Build Debug AeroSpaceBar"
        },
        {
            "type": "lldb",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:AeroSpaceBar}",
            "name": "Release AeroSpaceBar",
            "program": "${workspaceFolder:AeroSpaceBar}/.build/release/AeroSpaceBar",
            "preLaunchTask": "swift: Build Release AeroSpaceBar"
        }
    ]
}