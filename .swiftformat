# SwiftFormat Configuration for AeroSpaceBar
# https://github.com/nicklockwood/SwiftFormat

# Indentation
--indent 4
--tabwidth 4
--smarttabs enabled

# Line wrapping
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--wrapconditions before-first
--wraptypealiases before-first
--func-attributes prev-line
--type-attributes prev-line
--stored-var-attributes same-line
--computed-var-attributes prev-line
--complex-attributes prev-line
--non-complex-attributes prev-line

# Spacing
--trimwhitespace always
--insertlines enabled
--removelines enabled
--allman false
--elseposition same-line
--emptybraces spaced
--ranges spaced
--semicolons never
--commas never
--hexliteralcase uppercase
--exponentcase lowercase
--line-between-guards true

# Imports
--importgrouping alphabetized

# Comments
# Copyright notices vary by file; do not overwrite original or contributor attribution.
--header ignore
--stripunusedargs always

# Swift version
--swiftversion 6.2

# Redundant
--redundant-async always

# rules
--disable numberFormatting
--disable preferForLoop
--disable redundantInternal
--disable modifierOrder
--enable blankLineAfterImports
--enable blankLineAfterSwitchCase
--enable blankLinesAfterGuardStatements
--enable blankLinesBetweenScopes
--enable consecutiveBlankLines
--enable consecutiveSpaces
--enable docCommentsBeforeModifiers
--enable duplicateImports
--enable leadingDelimiters
--enable linebreakAtEndOfFile
--enable privateStateVariables
--enable redundantAsync
--enable redundantMemberwiseInit
--enable spaceAroundComments
--enable wrapMultilineFunctionChains
--enable wrapSwitchCases
